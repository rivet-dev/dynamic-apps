		-rm -f ./$(DEPDIR)/test_actions-test-actions.Po
	-rm -f ./$(DEPDIR)/test_icons-test-icons.Po
	-rm -f ./$(DEPDIR)/test_positioning-test-positioning.Po
	-rm -f ./$(DEPDIR)/test_text-test-text.Po
	-rm -f Makefile
