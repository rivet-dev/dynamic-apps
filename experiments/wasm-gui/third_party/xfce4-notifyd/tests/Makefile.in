all: all-am

.SUFFIXES:
.SUFFIXES: .c .lo .o .obj
$(srcdir)/Makefile.in: @MAINTAINER_MODE_TRUE@ $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign tests/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --foreign tests/Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure: @MAINTAINER_MODE_TRUE@ $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4): @MAINTAINER_MODE_TRUE@ $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):

clean-noinstPROGRAMS:
	@list='$(noinst_PROGRAMS)'; test -n "$$list" || exit 0; \
	echo " rm -f" $$list; \
	rm -f $$list || exit $$?; \
	test -n "$(EXEEXT)" || exit 0; \
	list=`for p in $$list; do echo "$$p"; done | sed 's/$(EXEEXT)$$//'`; \
	echo " rm -f" $$list; \
	rm -f $$list

test-actions$(EXEEXT): $(test_actions_OBJECTS) $(test_actions_DEPENDENCIES) $(EXTRA_test_actions_DEPENDENCIES) 
	@rm -f test-actions$(EXEEXT)
	$(AM_V_CCLD)$(test_actions_LINK) $(test_actions_OBJECTS) $(test_actions_LDADD) $(LIBS)

test-icons$(EXEEXT): $(test_icons_OBJECTS) $(test_icons_DEPENDENCIES) $(EXTRA_test_icons_DEPENDENCIES) 
	@rm -f test-icons$(EXEEXT)
	$(AM_V_CCLD)$(test_icons_LINK) $(test_icons_OBJECTS) $(test_icons_LDADD) $(LIBS)

test-positioning$(EXEEXT): $(test_positioning_OBJECTS) $(test_positioning_DEPENDENCIES) $(EXTRA_test_positioning_DEPENDENCIES) 
	@rm -f test-positioning$(EXEEXT)
	$(AM_V_CCLD)$(test_positioning_LINK) $(test_positioning_OBJECTS) $(test_positioning_LDADD) $(LIBS)

test-text$(EXEEXT): $(test_text_OBJECTS) $(test_text_DEPENDENCIES) $(EXTRA_test_text_DEPENDENCIES) 
	@rm -f test-text$(EXEEXT)
	$(AM_V_CCLD)$(test_text_LINK) $(test_text_OBJECTS) $(test_text_LDADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

