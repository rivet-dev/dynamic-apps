install-dist_brightthemeDATA: $(dist_brighttheme_DATA)
	@$(NORMAL_INSTALL)
	@list='$(dist_brighttheme_DATA)'; test -n "$(brightthemedir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(brightthemedir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(brightthemedir)" || exit 1; \
	fi; \
	for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  echo "$$d$$p"; \
	done | $(am__base_list) | \
	while read files; do \
	  echo " $(INSTALL_DATA) $$files '$(DESTDIR)$(brightthemedir)'"; \
	  $(INSTALL_DATA) $$files "$(DESTDIR)$(brightthemedir)" || exit $$?; \
	done

uninstall-dist_brightthemeDATA:
	@$(NORMAL_UNINSTALL)
	@list='$(dist_brighttheme_DATA)'; test -n "$(brightthemedir)" || list=; \
	files=`for p in $$list; do echo $$p; done | sed -e 's|^.*/||'`; \
	dir='$(DESTDIR)$(brightthemedir)'; $(am__uninstall_files_from_dir)
