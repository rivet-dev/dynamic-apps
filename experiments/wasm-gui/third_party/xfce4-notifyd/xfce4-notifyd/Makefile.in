xfce4_notifyddir = $(HELPER_PATH_PREFIX)/xfce4/notifyd
xfce4_notifyd_SOURCES = \
	$(top_srcdir)/common/xfce-notify-common.h \
	main.c \
	xfce-notification.c \
	xfce-notification.h \
	xfce-notify-fdo-gbus.c \
	xfce-notify-fdo-gbus.h \
	xfce-notify-gbus.c \
	xfce-notify-gbus.h \
	xfce-notify-log.c \
	xfce-notify-log.h \
	xfce-notify-daemon.c \
	xfce-notify-daemon.h \
	xfce-notify-daemon-log.c \
	xfce-notify-daemon-log.h \
	xfce-notify-marshal.c \
	xfce-notify-marshal.h \
	xfce-notify-types.c \
	xfce-notify-types.h \
	xfce-notify-window.c \
	xfce-notify-window.h

xfce4_notifyd_CFLAGS = \
	-DG_LOG_DOMAIN=\"xfce4-notifyd\" \
	-DLOCALEDIR=\"$(localedir)\" \
	-I$(top_srcdir) \
	-I$(builddir) \
	$(LIBXFCE4UTIL_CFLAGS) \
	$(XFCONF_CFLAGS) \
	$(LIBXFCE4UI_CFLAGS) \
	$(GIO_CFLAGS) \
	$(GIO_UNIX_CFLAGS) \
	$(GTK_CFLAGS) \
	$(SQLITE_CFLAGS) \
	$(LIBX11_CFLAGS) \
	$(CANBERRA_GTK_CFLAGS) \
	$(GTK_LAYER_SHELL_CFLAGS)

xfce4_notifyd_LDADD = \
	$(top_builddir)/common/libxfce-notifyd-common.la \
	$(LIBXFCE4UTIL_LIBS) \
	$(XFCONF_LIBS) \
	$(LIBXFCE4UI_LIBS) \
	$(GIO_LIBS) \
	$(GIO_UNIX_LIBS) \
	$(GTK_LIBS) \
	$(SQLITE_LIBS) \
	$(LIBX11_LIBS) \
	$(CANBERRA_GTK_LIBS) \
	$(GTK_LAYER_SHELL_LIBS)

service_in_files = \
	org.xfce.xfce4-notifyd.Notifications.service.in \
	org.xfce.xfce4-notifyd.Notifyd.service.in

systemd_user_in_files = xfce4-notifyd.service.in
autostart_in_files = xfce4-notifyd.desktop.in
dist_noinst_DATA = \
	$(service_in_files) \
	$(systemd_user_in_files) \
	$(autostart_in_files) \
	xfce-notify-dbus.xml \
	xfce-notify-fdo-dbus.xml \
	xfce-notify-marshal.list

@USE_DBUS_START_DAEMON_TRUE@servicedir = $(DBUS_SERVICE_DIR)
@USE_DBUS_START_DAEMON_TRUE@service_DATA = $(service_in_files:.service.in=.service)
@USE_SYSTEMD_TRUE@systemd_userdir = $(SYSTEMD_USER_SERVICE_DIR)
@USE_SYSTEMD_TRUE@systemd_user_DATA = $(systemd_user_in_files:.service.in=.service)
@USE_SYSTEMD_FALSE@systemd_service = 
@USE_SYSTEMD_TRUE@systemd_service = SystemdService=xfce4-notifyd.service
@USE_SYSTEMD_FALSE@xdg_autostart_exec = $(xfce4_notifyddir)/xfce4-notifyd
@USE_SYSTEMD_TRUE@xdg_autostart_exec = sh -c "systemctl --user start xfce4-notifyd.service 2>/dev/null || exec $(xfce4_notifyddir)/xfce4-notifyd"
@USE_XDG_AUTOSTART_TRUE@autostartdir = $(sysconfdir)/xdg/autostart
@USE_XDG_AUTOSTART_TRUE@autostart_DATA = $(autostart_in_files:.desktop.in=.desktop)
built_xfce4_notifyd = \
	xfce-notify-fdo-gbus.c \
	xfce-notify-fdo-gbus.h \
	xfce-notify-gbus.c \
	xfce-notify-gbus.h \
	xfce-notify-marshal.c \
	xfce-notify-marshal.h

BUILT_SOURCES = \
	$(built_xfce4_notifyd)

CLEANFILES = \
	$(built_xfce4_notifyd) \
	$(service_DATA) \
	$(systemd_user_DATA) \
	$(autostart_DATA)

all: $(BUILT_SOURCES)
	$(MAKE) $(AM_MAKEFLAGS) all-am

.SUFFIXES:
.SUFFIXES: .c .lo .o .obj
$(srcdir)/Makefile.in: @MAINTAINER_MODE_TRUE@ $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign xfce4-notifyd/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --foreign xfce4-notifyd/Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure: @MAINTAINER_MODE_TRUE@ $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4): @MAINTAINER_MODE_TRUE@ $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):
install-xfce4_notifydPROGRAMS: $(xfce4_notifyd_PROGRAMS)
	@$(NORMAL_INSTALL)
	@list='$(xfce4_notifyd_PROGRAMS)'; test -n "$(xfce4_notifyddir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(xfce4_notifyddir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(xfce4_notifyddir)" || exit 1; \
	fi; \
	for p in $$list; do echo "$$p $$p"; done | \
	sed 's/$(EXEEXT)$$//' | \
	while read p p1; do if test -f $$p \
	 || test -f $$p1 \
	  ; then echo "$$p"; echo "$$p"; else :; fi; \
	done | \
	sed -e 'p;s,.*/,,;n;h' \
	    -e 's|.*|.|' \
	    -e 'p;x;s,.*/,,;s/$(EXEEXT)$$//;$(transform);s/$$/$(EXEEXT)/' | \
	sed 'N;N;N;s,\n, ,g' | \
	$(AWK) 'BEGIN { files["."] = ""; dirs["."] = 1 } \
	  { d=$$3; if (dirs[d] != 1) { print "d", d; dirs[d] = 1 } \
	    if ($$2 == $$4) files[d] = files[d] " " $$1; \
	    else { print "f", $$3 "/" $$4, $$1; } } \
	  END { for (d in files) print "f", d, files[d] }' | \
	while read type dir files; do \
	    if test "$$dir" = .; then dir=; else dir=/$$dir; fi; \
	    test -z "$$files" || { \
	    echo " $(INSTALL_PROGRAM_ENV) $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL_PROGRAM) $$files '$(DESTDIR)$(xfce4_notifyddir)$$dir'"; \
	    $(INSTALL_PROGRAM_ENV) $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL_PROGRAM) $$files "$(DESTDIR)$(xfce4_notifyddir)$$dir" || exit $$?; \
	    } \
	; done

uninstall-xfce4_notifydPROGRAMS:
	@$(NORMAL_UNINSTALL)
	@list='$(xfce4_notifyd_PROGRAMS)'; test -n "$(xfce4_notifyddir)" || list=; \
	files=`for p in $$list; do echo "$$p"; done | \
	  sed -e 'h;s,^.*/,,;s/$(EXEEXT)$$//;$(transform)' \
	      -e 's/$$/$(EXEEXT)/' \
	`; \
	test -n "$$list" || exit 0; \
	echo " ( cd '$(DESTDIR)$(xfce4_notifyddir)' && rm -f" $$files ")"; \
	cd "$(DESTDIR)$(xfce4_notifyddir)" && rm -f $$files

clean-xfce4_notifydPROGRAMS:
	@list='$(xfce4_notifyd_PROGRAMS)'; test -n "$$list" || exit 0; \
	echo " rm -f" $$list; \
	rm -f $$list || exit $$?; \
	test -n "$(EXEEXT)" || exit 0; \
	list=`for p in $$list; do echo "$$p"; done | sed 's/$(EXEEXT)$$//'`; \
	echo " rm -f" $$list; \
	rm -f $$list

xfce4-notifyd$(EXEEXT): $(xfce4_notifyd_OBJECTS) $(xfce4_notifyd_DEPENDENCIES) $(EXTRA_xfce4_notifyd_DEPENDENCIES) 
	@rm -f xfce4-notifyd$(EXEEXT)
	$(AM_V_CCLD)$(xfce4_notifyd_LINK) $(xfce4_notifyd_OBJECTS) $(xfce4_notifyd_LDADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

