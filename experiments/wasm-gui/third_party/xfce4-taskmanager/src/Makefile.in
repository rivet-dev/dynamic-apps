@MAINTAINER_MODE_TRUE@process-window_ui.h: process-window.ui
@MAINTAINER_MODE_TRUE@	$(AM_V_GEN) xdt-csource --static --strip-comments --strip-content --name=process_window_ui $< >$@
@MAINTAINER_MODE_TRUE@settings-dialog_ui.h: settings-dialog.ui
@MAINTAINER_MODE_TRUE@	$(AM_V_GEN) xdt-csource --static --strip-comments --strip-content --name=settings_dialog_ui $< >$@

