clean-generic:
	-test -z "$(CLEANFILES)" || rm -f $(CLEANFILES)

distclean-generic:
	-test -z "$(CONFIG_CLEAN_FILES)" || rm -f $(CONFIG_CLEAN_FILES)
	-test . = "$(srcdir)" || test -z "$(CONFIG_CLEAN_VPATH_FILES)" || rm -f $(CONFIG_CLEAN_VPATH_FILES)
	-test -z "$(top_builddir)/common/$(DEPDIR)/$(am__dirstamp)" || rm -f $(top_builddir)/common/$(DEPDIR)/$(am__dirstamp)
	-test -z "$(top_builddir)/common/$(am__dirstamp)" || rm -f $(top_builddir)/common/$(am__dirstamp)

