install-exec-hook::
#	$(AM_V_at)rm -f $(DESTDIR)$(libdir)/libXaw.6.so
#	$(AM_V_GEN)(cd $(DESTDIR)$(libdir) && $(LN_S) libXaw6.6.so libXaw.6.so)
	$(AM_V_at)rm -f $(DESTDIR)$(libdir)/libXaw.so.6
	$(AM_V_GEN)(cd $(DESTDIR)$(libdir) && $(LN_S) libXaw6.so.6 libXaw.so.6)

uninstall-local::
#	$(AM_V_at)rm -f $(DESTDIR)$(libdir)/libXaw.6.so
	$(AM_V_at)rm -f $(DESTDIR)$(libdir)/libXaw.so.6

