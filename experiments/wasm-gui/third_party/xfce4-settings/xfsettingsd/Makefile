installdirs:
	for dir in "$(DESTDIR)$(bindir)" "$(DESTDIR)$(autostartdir)" "$(DESTDIR)$(settingsdir)"; do \
	  test -z "$$dir" || $(MKDIR_P) "$$dir"; \
	done
