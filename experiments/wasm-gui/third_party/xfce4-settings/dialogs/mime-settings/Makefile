	$(AM_V_CC)$(CC) $(DEFS) $(DEFAULT_INCLUDES) $(INCLUDES) $(AM_CPPFLAGS) $(CPPFLAGS) $(xfce4_mime_settings_CFLAGS) $(CFLAGS) -MT xfce4_mime_settings-xfce-mime-window.obj -MD -MP -MF $(DEPDIR)/xfce4_mime_settings-xfce-mime-window.Tpo -c -o xfce4_mime_settings-xfce-mime-window.obj `if test -f 'xfce-mime-window.c'; then $(CYGPATH_W) 'xfce-mime-window.c'; else $(CYGPATH_W) '$(srcdir)/xfce-mime-window.c'; fi`
	$(AM_V_at)$(am__mv) $(DEPDIR)/xfce4_mime_settings-xfce-mime-window.Tpo $(DEPDIR)/xfce4_mime_settings-xfce-mime-window.Po
