AR='/home/nathan/secure-exec/registry/native/c/vendor/wasi-sdk/bin/llvm-ar'
lt_ar_flags='cr'
AR_FLAGS='cr'
archiver_list_spec='@'
STRIP='strip'
RANLIB='/home/nathan/secure-exec/registry/native/c/vendor/wasi-sdk/bin/llvm-ranlib'
