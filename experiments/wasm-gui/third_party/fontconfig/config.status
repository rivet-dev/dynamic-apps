double_quote_subst='s/\(["`\\]\)/\\\1/g'
delay_variable_subst='s/\\\\\\\\\\\$/\\\\\\$/g'
macro_version='2.4.7'
macro_revision='2.4.7'
enable_static='yes'
AS='as'
DLLTOOL='dlltool'
OBJDUMP='objdump'
enable_shared='no'
pic_mode='default'
enable_fast_install='needless'
shared_archive_member_spec=''
SHELL='/bin/bash'
ECHO='printf %s\n'
PATH_SEPARATOR=':'
host_alias='wasm32-wasi'
